# Copy this file to .env and replace every change-me value before deployment.
MYSQL_USER=moyamoya
MYSQL_PASSWORD=change-me-db-password
MYSQL_ROOT_PASSWORD=change-me-root-password

# Use a random value of at least 32 bytes. Example: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-secret-at-least-32-bytes

# Comma-separated frontend origins. Do not add a trailing slash.
CORS_ALLOWED_ORIGINS=http://localhost:3000

APP_PORT=8080
ACCESS_TOKEN_TTL=3600000
REFRESH_TOKEN_TTL=1209600000
PARENT_MODE_TOKEN_TTL=600000
